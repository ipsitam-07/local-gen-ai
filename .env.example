# Application Settings
APP_NAME="Local GenAI Data Assistant"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# PostgreSQL (Admin / Migration User)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="genai_data"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"

# PostgreSQL (Future Read-Only User for SQL Agent)
POSTGRES_RO_USER="genai_reader"
POSTGRES_RO_PASSWORD="reader_password"

# Qdrant Vector Store
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME="documents"

# Ollama Local LLM
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=60

# Data Directories
DOCUMENTS_DIR="data/documents"
